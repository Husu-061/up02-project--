venv/
env/
ENV/
.venv/

# Настройки редакторов
.vscode/
.idea/
*.swp

# Системные файлы
.DS_Store
Thumbs.db

# Логи
*.log

# Базы данных
*.db
*.sqlite
*.sqlite3

# Секретные данные
credentials.txt
.env
*.key

# Временные файлы
*.tmp
*.bak

# Jupyter Notebook
.ipynb_checkpoints/

# Временные файлы Excel (создаются при открытии книги)
~$*.xlsx

# Журнал транзакций SQLite
*.db-journal